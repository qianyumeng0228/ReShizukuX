<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overrides. The debug build carries applicationIdSuffix ".debug"
  (moe.shizuku.privileged.api.debug) so it installs ALONGSIDE the release build instead of
  replacing it. Because it is a separate package, it must not redeclare the fixed-name
  permissions that the release build already owns (xyz.shizuku.extra.permission.MANAGER,
  xyz.shizuku.extra.permission.API_V23, and moe.shizuku.manager.permission.API_V23);
  redeclaring them fails install with INSTALL_FAILED_DUPLICATE_PERMISSION.

  (The Dhizuku provider authority is resolved from ${applicationId} in the main manifest as
  ${applicationId}.dhizuku_server.provider, so no placeholder is needed here.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="xyz.shizuku.extra.permission.MANAGER"
        tools:node="remove" />

    <permission
        android:name="xyz.shizuku.extra.permission.API_V23"
        tools:node="remove" />

    <permission
        android:name="moe.shizuku.manager.permission.API_V23"
        tools:node="remove" />

    <application>
        <!-- Debug-only diagnostic activity for verifying the Dhizuku client protocol -->
        <activity
            android:name=".DhizukuProtoCheckActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light" />
    </application>

</manifest>
